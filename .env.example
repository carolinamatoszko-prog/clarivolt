# ============================================================
# Modèle de variables d'environnement.
#
# Ce fichier est VERSIONNÉ : il ne contient que des NOMS de
# variables, jamais de valeur. Ne jamais y écrire une vraie clé.
#
# Usage local :
#   cp .env.example .env.local   puis remplir les valeurs
#   .env.local est ignoré par git (voir .gitignore)
#
# En production : les valeurs vivent dans Vercel
#   Project Settings → Environment Variables
# ============================================================

# Clé API Brevo — Brevo → Settings → SMTP & API → API Keys
# Sert au Route Handler /api/waitlist à créer le contact.
# Côté serveur uniquement : ne JAMAIS préfixer NEXT_PUBLIC_,
# ce préfixe exposerait la clé dans le navigateur.
BREVO_API_KEY=

# Identifiant numérique de la liste d'attente
# Brevo → Contacts → Lists — l'id est dans l'URL de la liste
BREVO_LIST_ID=
